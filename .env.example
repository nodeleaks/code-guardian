# HTTP server
PORT=3000

# Redis (used by BullMQ for the scan queue and as the scan status/results store)
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank for a Redis with no AUTH configured (the local docker-compose one).
REDIS_PASSWORD=
# Set to "true" to connect over TLS (managed Redis providers usually require it).
REDIS_TLS=false

# Path or command name of the Trivy binary (must be on PATH or an absolute path)
TRIVY_BINARY_PATH=trivy

# How long a finished/failed scan record is kept in Redis (seconds)
SCAN_RECORD_TTL_SECONDS=86400

# Wall-clock cap applied separately to `git clone` and to `trivy fs`. Without
# it a hung clone or scan holds the single worker indefinitely.
SCAN_TIMEOUT_MS=300000

# Reject a cloned repository whose working tree exceeds this, before scanning.
# `--depth 1` bounds history, not tree size.
SCAN_MAX_REPO_SIZE_MB=1024

# Refuse new scans once this many jobs are already waiting.
SCAN_MAX_QUEUE_DEPTH=100

# Comma-separated list of origins allowed to call the GraphQL API from a
# browser (e.g. the web/ React app). Defaults to Vite's default dev port.
CORS_ORIGIN=http://localhost:5173

# Serves the Apollo landing page AND enables schema introspection. Keep this
# "false" anywhere reachable by untrusted clients.
GRAPHQL_PLAYGROUND=false
