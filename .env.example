# HTTP server
PORT=3000

# Redis (used by BullMQ for the scan queue and as the scan status/results store)
REDIS_HOST=localhost
REDIS_PORT=6379

# Path or command name of the Trivy binary (must be on PATH or an absolute path)
TRIVY_BINARY_PATH=trivy

# How long a finished/failed scan record is kept in Redis (seconds)
SCAN_RECORD_TTL_SECONDS=86400

# Comma-separated list of origins allowed to call the GraphQL API from a
# browser (e.g. the web/ React app). Defaults to Vite's default dev port.
CORS_ORIGIN=http://localhost:5173
